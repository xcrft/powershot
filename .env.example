# PowerShot reads settings from its process environment. A .env in the repository is
# untrusted input, so only *_API_KEY entries are accepted from that file. Copy this
# file to .env for provider keys; export every non-secret setting from the trusted
# shell, CI job, or wrapper that launches PowerShot.

# Which provider the judges call. Only the matching key is needed.
#   anthropic → ANTHROPIC_API_KEY   (the only provider with the agent tool loop)
#   openai    → OPENAI_API_KEY
#   gemini    → GEMINI_API_KEY, or GOOGLE_API_KEY
#   glm       → AI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is read as a fallback for the same provider
GOOGLE_API_KEY=
AI_API_KEY=

# Point a provider at a gateway or proxy. Each is a base URL, not a full endpoint.
# ANTHROPIC_BASE_URL=https://gateway.internal
# OPENAI_BASE_URL=https://gateway.internal/v1
# GEMINI_BASE_URL=https://gateway.internal
# AI_BASE_URL=https://gateway.internal/api/paas/v4

# How long to wait for a provider before failing the run. Default 120000.
# POWERSHOT_TIMEOUT_MS=120000

# Emit one OTLP trace per run. Unset means no telemetry at all.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Colour follows this and the terminal; set to any value to disable.
# NO_COLOR=1

# Persistent gated-review cache. It must resolve outside the reviewed repository.
# POWERSHOT_CACHE_DIR=/var/cache/powershot
